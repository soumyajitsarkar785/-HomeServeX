# -------------------------------------------------------------
# HomeServeX Environment Configuration Example
# Copy to .env and adjust variables as needed.
# -------------------------------------------------------------

# Environment
NODE_ENV=development
PORT=5000

# Database Connection (SQLite for local dev, PostgreSQL for staging/prod)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homeservex?schema=public"

# Frontend Application URLs (CORS & redirects)
FRONTEND_CUSTOMER_URL=http://localhost:5173
FRONTEND_PARTNER_URL=http://localhost:5174
FRONTEND_ADMIN_URL=http://localhost:5175
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Authentication & Session Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_homeservex_replace_in_prod_at_least_32_chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_homeservex_replace_in_prod_at_least_32_chars
SESSION_SECRET=dev_session_secret_homeservex_min_32_characters_random

# Platform Configuration
PLATFORM_DEFAULT_CURRENCY=INR
PLATFORM_COMMISSION_PERCENTAGE=15
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=3

# Optional Integrations (Placeholders)
MAPS_API_KEY=
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
EMAIL_PROVIDER_API_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
